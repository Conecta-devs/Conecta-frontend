{
  "rewrites": [
    {
      "source": "/socket.io/",
      "destination": "https://conecta-backend-eight.vercel.app/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://conecta-backend-eight.vercel.app/socket.io/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://conecta-backend-eight.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
